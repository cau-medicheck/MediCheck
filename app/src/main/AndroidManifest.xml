<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 알림을 띄우는 권한 (Android 13 이상에서는 사용자에게 물어봐야 한다) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 정확한 시각에 알람을 거는 권한. 복약 알림처럼 시각이 중요한 앱에 허용된다 (Android 13 이상) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 12에서는 위 권한이 없어서 이 권한을 대신 쓴다 -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- 폰을 다시 켰을 때 신호를 받는 권한 (꺼지면 사라지는 알람을 다시 걸기 위해) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 인터넷 연결 상태를 읽는 권한 (오프라인 상태 화면 S38). 설치할 때 자동으로 허용되고 사용자에게 묻지 않는다 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 기기의 본인 확인 창(생체인증·PIN)을 띄우는 권한 (앱 잠금 S41). 설치할 때 자동으로 허용되고 사용자에게 묻지 않는다 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        allowBackup="false": 안드로이드의 자동 백업(구글 클라우드로 앱 데이터를 복사해 두는 기능)을 끈다.
        화면에서 "계정과 복약 기록은 이 기기 안에만 저장된다"고 안내하므로, 그 말이 사실이 되게 하기 위해서다.
        기기를 바꿀 때는 앱의 '데이터 백업·복원'(S28)으로 직접 옮긴다.
    -->
    <application
        android:name=".MediCheckApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediCheck">
        <!--
            launchMode="singleTop": 앱 화면이 이미 맨 위에 떠 있으면 새로 하나 더 만들지 않고 그 화면을 다시 쓴다.
            (접힌 알림 묶음을 누르면 시스템이 "앱 열기"를 실행하는데, 그때 화면이 두 겹으로 쌓이지 않게 한다)
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.MediCheck"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            알람이 울리거나, 폰이 다시 켜지거나, 시각·시간대가 바뀌거나, 앱이 업데이트되면 깨어나는 수신기.
            exported="false": 다른 앱이 이 수신기를 부를 수 없다 (시스템과 우리 앱만 부른다).
        -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Android 12에서 사용자가 정확한 알람을 허용하면 오는 신호 → 정확한 알람으로 다시 건다 -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>